{
  "name": "@kyrspect/ui",
  "version": "0.1.0",
  "description": "Default UI for the Kyrspect video player.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./stats": {
      "types": "./dist/stats.d.ts",
      "import": "./dist/stats.js",
      "require": "./dist/stats.cjs"
    },
    "./waveform": {
      "types": "./dist/waveform.d.ts",
      "import": "./dist/waveform.js",
      "require": "./dist/waveform.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "devDependencies": {
    "tsup": "^8.4.0",
    "typescript": "^5.7.3"
  }
}
