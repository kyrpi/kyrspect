{
  "name": "@kyrspect/core",
  "version": "0.1.0",
  "description": "Framework-agnostic video playback engine for the web.",
  "keywords": [
    "video",
    "player",
    "hls",
    "dash",
    "widevine",
    "drm",
    "abr",
    "mse",
    "html5"
  ],
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@kyrspect/ui": "0.1.0",
    "dashjs": "^5.2.1",
    "hls.js": "^1.5.20"
  },
  "devDependencies": {
    "tsup": "^8.4.0",
    "typescript": "^5.7.3"
  }
}
