{
  "name": "kyrspect",
  "private": true,
  "version": "0.1.0",
  "license": "Apache-2.0",
  "description": "Modern video playback for the web.",
  "homepage": "https://github.com/kyrpi/kyrspect#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/kyrpi/kyrspect.git"
  },
  "bugs": {
    "url": "https://github.com/kyrpi/kyrspect/issues"
  },
  "type": "module",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "build": "npm run build -w @kyrspect/ui && npm run build -w @kyrspect/core && npm run build -w @kyrspect/react",
    "typecheck": "npm run typecheck -w @kyrspect/ui && npm run typecheck -w @kyrspect/core && npm run typecheck -w @kyrspect/react",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:ui": "node scripts/verify.mjs",
    "diagnose:ui": "node scripts/diagnose.mjs",
    "dev": "npm run dev -w @kyrspect/example-demo",
    "dev:demo": "npm run dev -w @kyrspect/example-demo",
    "dev:vanilla": "npm run dev -w @kyrspect/example-vanilla",
    "dev:react": "npm run dev -w @kyrspect/example-react",
    "dev:hls": "npm run dev -w @kyrspect/example-hls",
    "dev:dash": "npm run dev -w @kyrspect/example-dash",
    "dev:live": "npm run dev -w @kyrspect/example-livestream",
    "clean": "npm run clean --workspaces --if-present"
  },
  "engines": {
    "node": ">=18.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "jsdom": "^26.0.0",
    "playwright": "^1.62.1",
    "typescript": "^5.7.3",
    "vite": "^6.2.0",
    "vitest": "^3.0.6"
  }
}
